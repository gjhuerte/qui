# Build context is the repo root; BuildKit applies this file to docker-prod/ci.Dockerfile.
# CI builds web/dist before the image build, so it stays in the context.
.git
.github
documentation
scripts
web/node_modules
**/*_test.go
**/*.md
!go.md
.goreleaser*.yml
.pre-commit-config.yaml
LICENSE
AGENTS.md
CLAUDE.md
docker-dev
docker-prod/*
!docker-prod/entrypoint.sh
tmp
**/.env*
